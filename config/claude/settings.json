  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_CONFIG_DIR/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_CONFIG_DIR/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "paplay \"$CLAUDE_CONFIG_DIR/hooks/notification.wav\" || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay \"$CLAUDE_CONFIG_DIR/hooks/stop.wav\" || true",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest"
  },
  "enabledPlugins": {
    "kotlin-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "datadog@claude-plugins-official": true,
    "recap-plus@claude-recap-plus": true,
    "code-review@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": true,
    "coderabbit@anthropic-plugin-directory": true,
    "skill-creator@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "claude-security@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true
  },
  "outputStyle": "Concise",
  "language": "Japanese",
  "advisorModel": "fable",
  "companyAnnouncements": [
    "個人契約のClaude Codeです"
  ],
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "effortLevel": "high",
  "extraKnownMarketplaces": {
    "claude-recap-plus": {
      "source": {
        "source": "github",
        "repo": "skanehira/claude-recap-plus"
      }
    }
  }
}
